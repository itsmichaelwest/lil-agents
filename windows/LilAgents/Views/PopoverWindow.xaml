<Window
    x:Class="LilAgents.Views.PopoverWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LilAgents.Views"
    Title="lil agents">

    <!-- Root fills the entire window including title bar area.
         Background matches the theme's popover bg so the Win11 rounded
         corners reveal the right color. -->
    <Grid x:Name="RootContainer">
        <!-- Inner border with concentric corner radius (window is 8px,
             so inner content uses ~6px to look intentional). -->
        <Border
            x:Name="OuterBorder"
            Padding="0"
            Margin="0">
            <Grid RowDefinitions="Auto,Auto,*">
                <!-- Custom title bar -->
                <Grid
                    x:Name="TitleBar"
                    Grid.Row="0"
                    Height="32"
                    Padding="12,0,8,0"
                    CornerRadius="6,6,0,0">
                    <TextBlock
                        x:Name="TitleText"
                        VerticalAlignment="Center"
                        FontSize="12"
                        IsHitTestVisible="False" />
                    <Button
                        x:Name="CopyButton"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Padding="4"
                        MinWidth="0"
                        MinHeight="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="CopyButton_Click"
                        ToolTipService.ToolTip="Copy last response">
                        <FontIcon
                            x:Name="CopyIcon"
                            Glyph="&#xE8C8;"
                            FontSize="12" />
                    </Button>
                </Grid>

                <!-- Separator -->
                <Border
                    x:Name="Separator"
                    Grid.Row="1"
                    Height="1"
                    HorizontalAlignment="Stretch" />

                <!-- Chat view fills remaining space -->
                <local:ChatView
                    x:Name="Chat"
                    Grid.Row="2" />
            </Grid>
        </Border>
    </Grid>
</Window>
